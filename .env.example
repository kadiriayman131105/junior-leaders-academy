# Clé API Resend (https://resend.com) — envoi des formulaires vers la boîte de l'école
RESEND_API_KEY=

# Boîte qui reçoit les demandes d'inscription et les candidatures
SCHOOL_EMAIL=

# Expéditeur. Avant la vérification du domaine, Resend n'autorise que son adresse de test.
MAIL_FROM="Junior Leaders Academy <onboarding@resend.dev>"

# URL publique du site, utilisée pour le référencement
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optionnel. Dernières publications Instagram (Graph API, jeton longue durée).
# Sans ces variables, le site affiche les photos déposées dans public/gallery
# et un lien vers le compte Instagram.
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_USER_ID=
